#!/usr/bin/env bash
# plugin-uninstall <plugin-id>... — Barbarian's plugin uninstaller (2026-09-28, Dave: "right click
# on an item and if it is an installed plugin, be able to select Uninstall").
#
# Takes the named plugins' folders out of ~/.config/omarchy/plugins by moving them to the trash
# (gio trash — the theme grid's rule: destructive things stay reversible), ONE AT A TIME. The
# panel calls this DETACHED, ONCE for the whole batch, as it closes: bar-arrange-apply has
# already taken the widgets' entries out of shell.json and the hidden sidecar (its DEL:<id>
# directives), so this script never touches either file — it only clears the folders.
#
# ⚠️ ONE PROCESS FOR THE WHOLE BATCH, NEVER ONE PER PLUGIN. Four parallel copies once trashed
#    four folders in the same second and each restarted the shell, and the four concurrent
#    omarchy-restart-shell loops left FOUR live shells on the bar (2026-09-28). The batch runs
#    as one: the folders go one after another, each settling BARBARIAN_UNINSTALL_SETTLE
#    seconds (2) before the next, because every trash rebuilds the shell's whole QML root.
#
# ⚠️ AND THIS SCRIPT NEVER RESTARTS THE SHELL. A restart racing the trash's reload crashed
#    Quickshell outright once (IpcHandler::onPostReload mid-construction, crash jkm78li2mt) —
#    the reload takes longer than any settle, so they will always be able to overlap. Instead
#    it leaves the restart-owed stamp that install.sh honours on its next run (a commit, a run
#    by hand, the machine's self-heal): that path is busy-checked, alone and battle-tested.
#    The shell's own per-plugin reload ("Local plugin changed, reloading") already discards
#    the deleted plugin's code; the stamp is for the compiled-cached remainder.
#
# ⚠️ A WRITE UNDER ~/.config/omarchy/plugins RELOADS THE WHOLE SHELL, lock screen included
#    (see install_plugin_file in this repo's install.sh) — and a reload while the session is
#    LOCKED aborts the shell. The panel cannot be clicked while locked, but a lock can race
#    the click, so the script refuses then: the folders stay, the entries are already gone,
#    and the notification says to try again.
#
# A desk renumber may be running from the same panel close (desks changed too): it spends a few
# seconds with the desks parked at spare ids between two config reloads, and a reload inside
# that window breaks the pass — the same reason install.sh holds off. It is waited out first;
# a minute is many times the pass's length.
#
# BARBARIAN_UNINSTALL_WAIT (10) seconds to wait for the ids to leave the layout files;
# BARBARIAN_UNINSTALL_SETTLE (2) seconds of quiet between the trashes.
#
# Refuses: no id, an id with a slash, a folder that is not an installed plugin (no manifest),
# any id still named by the layout after the wait, and tinkerbell.arrange itself — the panel
# never lists itself, and this script lives inside the folder it would be trashing. A batch
# with one bad id is refused whole: folders only start leaving once every id checks out.
set -u

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="$OMARCHY_PATH/bin:$PATH"

# A plain ssh login has no WAYLAND_DISPLAY, and without it the lock cannot be read (install.sh,
# 2026-09-20). A default, not an override: a real session's value is left alone.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-[0-9]*; do
    [ -S "$sock" ] && export WAYLAND_DISPLAY="$(basename "$sock")" && break
  done
fi

RESTART_STAMP="$HOME/.local/state/omarchy/barbarian-restart-owed"
SELF_ID="tinkerbell.arrange"
ENTRY_WAIT="${BARBARIAN_UNINSTALL_WAIT:-10}"
SETTLE="${BARBARIAN_UNINSTALL_SETTLE:-2}"

notify() { omarchy-notification-send "$1" "$2" >/dev/null 2>&1 || true; }

# install.sh's reading, in three lines fewer: no shell running means nothing to crash.
session_locked() {
  pgrep -u "$(id -u)" -x quickshell >/dev/null 2>&1 || return 1
  local status
  status="$(omarchy-shell lock status 2>/dev/null)"
  case "$status" in
    *'"sessionLocked":true'*)  return 0 ;;
    *'"pending":true'*)        return 0 ;;
    *'"sessionLocked":false'*) return 1 ;;
  esac
  [ "$(omarchy-shell lock isLocked 2>/dev/null)" != "false" ]
}

renumbering() {
  pgrep -u "$(id -u)" -f '[b]in/ws-renumber' >/dev/null 2>&1
}

# Any of the batch's ids still sitting in either layout file — as a quoted JSON string, which
# an id never is anywhere else in them. A missing file is simply a clean one.
any_listed_in_bar() {
  local id file
  for id in "${ids[@]}"; do
    for file in "$HOME/.config/omarchy/shell.json" "$HOME/.config/omarchy/bar-hidden.json"; do
      grep -qF -- "\"$id\"" "$file" 2>/dev/null && return 0
    done
  done
  return 1
}

ids=()
for arg in "$@"; do
  case "$arg" in
    */|*/*|.|..)
      echo "plugin-uninstall: name plugins by id, not '$arg'" >&2; exit 1 ;;
    "$SELF_ID")
      echo "plugin-uninstall: Barbarian cannot uninstall itself" >&2; exit 1 ;;
  esac
  [ -f "$HOME/.config/omarchy/plugins/$arg/manifest.json" ] || {
    echo "plugin-uninstall: '$arg' is not an installed plugin" >&2; exit 1; }
  ids+=("$arg")
done
[ "${#ids[@]}" -gt 0 ] || { echo "plugin-uninstall: name a plugin by its id" >&2; exit 1; }

waited=0
while renumbering && [ "$waited" -lt 60 ]; do
  sleep 2
  waited=$((waited + 2))
done

if session_locked; then
  notify "Uninstall held back" "The screen locked — the plugins are still installed. Try again from the panel."
  echo "plugin-uninstall: the screen is locked; nothing was touched" >&2
  exit 1
fi

# The apply pass removes every entry from both files; only when that has landed do the folders
# go, so the shell never reloads against a layout that still names a plugin that is gone.
waited=0
while any_listed_in_bar && [ "$waited" -lt "$ENTRY_WAIT" ]; do
  sleep 0.2
  waited=$((waited + 1))
done
if any_listed_in_bar; then
  notify "Uninstall held back" "The layout write did not land — the plugins' folders are kept."
  echo "plugin-uninstall: a plugin is still in the bar layout; nothing was touched" >&2
  exit 1
fi
sleep "$SETTLE"

trashed=()
for id in "${ids[@]}"; do
  gio trash -- "$HOME/.config/omarchy/plugins/$id" 2>/dev/null || {
    echo "plugin-uninstall: could not move $id to the trash" >&2
    [ "${#trashed[@]}" -gt 0 ] \
      && notify "Plugin uninstalled" "${trashed[*]} are in the trash, if you want them back."
    exit 1
  }
  trashed+=("$id")
  # Every trash rebuilds the shell's QML root; the next folder waits for that to finish.
  sleep "$SETTLE"
done

if [ "${#ids[@]}" -eq 1 ]; then
  notify "Plugin uninstalled" "${ids[0]} is in the trash, if you want it back."
else
  notify "Plugin uninstalled" "${ids[*]} are in the trash, if you want them back."
fi

# The restart is owed, not done here (see the header): install.sh's next run does it, alone
# and busy-checked. Nothing running means nothing to restart — the next shell to start reads
# the folder as it is.
if pgrep -u "$(id -u)" -x quickshell >/dev/null 2>&1; then
  mkdir -p "$(dirname "$RESTART_STAMP")"
  : > "$RESTART_STAMP"
fi
