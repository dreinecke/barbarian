#!/usr/bin/env bash
# bar-arrange-apply <widget-id>... — rewrite the RIGHT section of ~/.config/omarchy/shell.json
# to the given id order. Each entry's own settings (the clock's formats, sizes) travel with it
# untouched, because entries are reordered as whole objects, never rebuilt. Ids in the file but
# not in the arguments (the invisible tinkerbell.arrange widget itself) keep their place at the
# end. The write is tmp+rename, so a crash mid-write cannot half-eat the bar.
#
# Refuses rather than guesses: an argument that names no current right-section entry, or names
# one twice, aborts with the file unchanged.
set -euo pipefail
python3 - "$@" <<'PY'
import json, os, sys, tempfile

path = os.path.expanduser("~/.config/omarchy/shell.json")
want = sys.argv[1:]
if not want:
    sys.exit("bar-arrange-apply: no ids given")

with open(path) as f:
    data = json.load(f)
right = data["bar"]["layout"]["right"]

pools = {}
for entry in right:
    pools.setdefault(entry["id"], []).append(entry)

ordered = []
for wid in want:
    pool = pools.get(wid)
    if not pool:
        sys.exit(f"bar-arrange-apply: '{wid}' is not in the right section (or named twice)")
    ordered.append(pool.pop(0))

# Whatever was not named keeps its relative order, after the named ones.
leftovers = [e for e in right if not any(e is o for o in ordered)]
data["bar"]["layout"]["right"] = ordered + leftovers

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".shell.json.")
try:
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)
except BaseException:
    os.unlink(tmp)
    raise
PY
