#!/usr/bin/env bash
# bar-arrange-apply <L|R>:<widget-id>[:hidden]... — rewrite the LEFT and RIGHT sections of
# ~/.config/omarchy/shell.json to the given order, and park ids marked :hidden in
# ~/.config/omarchy/bar-hidden.json. Two lanes since 2026-09-01 (Dave asked for icons on
# the far left); hiding since the same day (Dave: Bluetooth is "noise/clutter 99% of the
# time but occasionally I want" — so a hidden entry is MOVED to the sidecar with its whole
# settings object, its lane and its position, never deleted).
#
# Entries travel as whole objects, so per-widget settings (the clock's formats, the
# spacer's size) survive a reorder, a lane change and a hide/show round-trip. Ids in the
# file but not in the arguments (the invisible tinkerbell.arrange widget itself) keep
# their place at the end of the lane they were already in. Writes are tmp+rename, so a
# crash mid-write cannot half-eat the bar.
#
# Refuses rather than guesses: an argument that names no current entry (either lane or
# the sidecar), or names one twice, aborts with both files unchanged.
set -euo pipefail
python3 - "$@" <<'PY'
import json, os, sys, tempfile

path = os.path.expanduser("~/.config/omarchy/shell.json")
side = os.path.expanduser("~/.config/omarchy/bar-hidden.json")
if not sys.argv[1:]:
    sys.exit("bar-arrange-apply: no ids given")

want = []  # (lane, id, hidden)
for arg in sys.argv[1:]:
    parts = arg.split(":")
    if parts[0] in ("L", "R"):
        lane, wid = parts[0], parts[1]
        hid = len(parts) > 2 and parts[2] == "hidden"
    else:  # bare id — the pre-lane call form; those panels only knew the right section
        lane, wid = "R", parts[0]
        hid = len(parts) > 1 and parts[1] == "hidden"
    want.append((lane, wid, hid))

with open(path) as f:
    data = json.load(f)
layout = data["bar"]["layout"]
sections = {"L": layout.get("left", []), "R": layout.get("right", [])}

parked_in = {"L": [], "R": []}
if os.path.exists(side):
    with open(side) as f:
        sd = json.load(f)
    parked_in["L"] = sd.get("left", [])
    parked_in["R"] = sd.get("right", [])

pools = {}
for sec in ("L", "R"):
    for entry in sections[sec]:
        pools.setdefault(entry["id"], []).append(entry)
    for row in parked_in[sec]:
        pools.setdefault(row["entry"]["id"], []).append(row["entry"])

ordered = {"L": [], "R": []}
parked = {"L": [], "R": []}
pos = {"L": 0, "R": 0}
for lane, wid, hid in want:
    pool = pools.get(wid)
    if not pool:
        sys.exit(f"bar-arrange-apply: '{wid}' is not in the bar or hidden list (or named twice)")
    entry = pool.pop(0)
    if hid:
        parked[lane].append({"index": pos[lane], "entry": entry})
    else:
        ordered[lane].append(entry)
    pos[lane] += 1

# Whatever was not named stays where it was: an unnamed VISIBLE entry keeps its lane,
# after the named ones; an unnamed HIDDEN entry stays parked in the sidecar. That second
# half was missing until 2026-09-01, and a caller that did not know about the sidecar
# (the pre-hide panel, still rendering out of a stale shell) silently destroyed the
# hidden Bluetooth entry through it.
named = [e for lane in ("L", "R") for e in ordered[lane]] \
      + [r["entry"] for lane in ("L", "R") for r in parked[lane]]
for sec, key in (("L", "left"), ("R", "right")):
    leftovers = [e for e in sections[sec] if not any(e is o for o in named)]
    layout[key] = ordered[sec] + leftovers
    for row in parked_in[sec]:
        if not any(row["entry"] is o for o in named):
            parked[sec].append({"index": row.get("index", 0), "entry": row["entry"]})

def write(p, obj):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix="." + os.path.basename(p) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(obj, f, indent=2)
            f.write("\n")
        os.replace(tmp, p)
    except BaseException:
        os.unlink(tmp)
        raise

write(path, data)
write(side, {"left": parked["L"], "right": parked["R"]})
PY
