#!/usr/bin/env bash
# ws-bg-remove <image-path> — take a background image out of the current theme: every desk pinned
# to it goes back to Auto, then one of Dave's own images goes to the trash and one of the theme's
# own is hidden.
#
# Barbarian's × on an image tile (Dave, 2026-09-03: "we need to be able to remove a background
# as well. Hover reveals an x in top right. And sets the background to auto"). An image in
# ~/.config/omarchy/backgrounds/<theme>/ — the folder ws-bg-add copies into — is Dave's, so the
# file itself goes. A theme's shipped images are not his to delete (Dave, 2026-09-25, on
# waffle-cat, whose six images all came with the theme): the theme's folder is rebuilt on every
# theme switch and the theme it comes from may be a git clone, so the image's name is added to
# workspace-backgrounds/<theme>/hidden-images instead. The picker leaves hidden images out, and
# per-workspace-wallpaper.sh passes an Auto desk on from a hidden image to the next one.
#
# Every desk's pin to the image is dropped, not just the desk whose picker was open. A pin is a
# symlink to the file; per-workspace-wallpaper.sh skips a pin whose target is gone, so those
# desks would fall back to Auto on their next switch anyway, but the desk on screen would keep
# the removed image until then and a dangling link would be left behind in the pins folder.
# ws-bg-pick does each unpin and repaints when that desk is the one on screen. The file itself
# is trashed (`gio trash`), not deleted, so a wrong click can be undone from Files; a hidden
# image comes back with ws-bg-restore.
set -euo pipefail

IMG="${1:?usage: ws-bg-remove <image-path>}"
HERE="$(dirname "$(readlink -f "$0")")"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current"
THEME="$(cat "$STATE/theme.name" 2>/dev/null)"
[ -n "$THEME" ] || { echo "ws-bg-remove: no current theme name" >&2; exit 1; }
USERBG="$HOME/.config/omarchy/backgrounds"
THEMEBG="$(readlink -f "$STATE/theme")/backgrounds"

REAL="$(realpath -- "$IMG")"
case "$REAL" in
  "$USERBG"/*)  HOW=trash ;;
  "$THEMEBG"/*) HOW=hide ;;
  *) echo "ws-bg-remove: not one of this theme's backgrounds: $IMG" >&2; exit 1 ;;
esac
[ -f "$REAL" ] || { echo "ws-bg-remove: no such image: $REAL" >&2; exit 1; }

PINDIR="$HOME/.config/omarchy/workspace-backgrounds/$THEME"
for pin in "$PINDIR"/ws*.*; do
  [ -L "$pin" ] || [ -e "$pin" ] || continue
  [ "$(readlink -f -- "$pin" 2>/dev/null)" = "$REAL" ] || continue
  n="${pin##*/ws}"; n="${n%%.*}"
  "$HERE/ws-bg-pick" "$n" default
  echo "unpinned ws$n"
done

if [ "$HOW" = hide ]; then
  mkdir -p "$PINDIR"
  grep -qxF -- "${REAL##*/}" "$PINDIR/hidden-images" 2>/dev/null \
    || printf '%s\n' "${REAL##*/}" >> "$PINDIR/hidden-images"
  echo "hid $REAL"
else
  if command -v gio >/dev/null 2>&1; then
    gio trash -- "$REAL" 2>/dev/null || rm -f -- "$REAL"
  else
    rm -f -- "$REAL"
  fi
  echo "removed $REAL"
fi

# An Auto desk on screen may have been showing the image; the watcher only wakes on a switch.
WATCHER="$HOME/.config/omarchy/workspace-backgrounds/per-workspace-wallpaper.sh"
if [ -x "$WATCHER" ]; then
  "$WATCHER" apply
fi
